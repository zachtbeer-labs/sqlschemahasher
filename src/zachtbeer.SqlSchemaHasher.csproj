<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!--
      net6.0/net7.0 were dropped in 2.0.0. They were not merely EOL — they were broken: those TFMs
      bind Microsoft.Data.SqlClient's netstandard2.0 asset, whose only runtime implementation is
      win/net462, so on Linux/macOS the first SqlConnection.OpenAsync threw NullReferenceException.
      tests/SqlSchemaHash.SmokeTests is what proved it; it now runs every TFM listed here.
    -->
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- NuGet Package Metadata -->
    <PackageId>zachtbeer.SqlSchemaHasher</PackageId>
    <Authors>Zachtbeer Labs B.V.</Authors>
    <Company>Zachtbeer Labs B.V.</Company>
    <Description>Deterministic SHA256 hashing for SQL Server database schemas. Extract and hash tables, stored procedures, user-defined table types, views, functions, triggers, sequences, synonyms, and extended properties for schema comparison and change detection.</Description>
    <PackageTags>sqlserver;schema;hash;database;migration;dacpac;schema-drift;change-detection</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/zachtbeer-labs/sqlschemahasher</RepositoryUrl>
    <PackageProjectUrl>https://zachtbeer-labs.github.io/sqlschemahasher/</PackageProjectUrl>
    <Copyright>Copyright (c) 2026 Zachtbeer Labs B.V.</Copyright>
    <PackageReleaseNotes>https://github.com/zachtbeer-labs/sqlschemahasher/releases</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="/" />
    <None Include="../icon.png" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SqlSchemaHash.IntegrationTests" />
    <InternalsVisibleTo Include="SqlSchemaHash.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
  </ItemGroup>
</Project>
